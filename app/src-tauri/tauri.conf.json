{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Hypercube",
  "version": "0.1.0",
  "identifier": "com.hypercube.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5184",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hypercube",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "center": true,
        "visible": false,
        "backgroundColor": "#0B132D"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Todos os seus agentes, num cubo só",
    "licenseFile": "../../LICENSE"
  }
}

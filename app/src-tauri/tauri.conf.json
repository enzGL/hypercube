{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Hypercube",
  "version": "0.1.0",
  "identifier": "com.hypercube.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5184",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hypercube",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "visible": false,
        "backgroundColor": "#00000000",
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob: https://avatars.githubusercontent.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost https://api.github.com https://avatars.githubusercontent.com"
    }
  },
  "bundle": {
    "active": true,
    "resources": { "../../router/server.js": "router/server.js", "../../router/config.default.json": "router/config.default.json" },
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Todos os seus agentes, num cubo só",
    "licenseFile": "../../LICENSE"
  }
}
